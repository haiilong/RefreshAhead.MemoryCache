<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

        <PackageId>RefreshAhead.MemoryCache.HealthChecks</PackageId>
        <Version>1.1.1</Version>
        <Description>Health check for RefreshAhead.MemoryCache. Reports the warm-up and refresh state of every registered refresh-ahead memory cache through Microsoft.Extensions.Diagnostics.HealthChecks.</Description>
        <PackageTags>cache;memory-cache;refresh-ahead;health-check;healthchecks;aspnetcore;diagnostics</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl Condition="'$(GITHUB_ACTIONS)' == 'true'">true</PublishRepositoryUrl>
        <EmbedUntrackedSources Condition="'$(GITHUB_ACTIONS)' == 'true'">true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" Condition="'$(GITHUB_ACTIONS)' == 'true'" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\RefreshAhead.MemoryCache\RefreshAhead.MemoryCache.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
